{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaws",
  // Cloudflare のアカウント（ni-hongo）
  "account_id": "2e998ce6e8a59b4583b436cdfcdbc393",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-30",
  // @anthropic-ai/sdk が Node 互換 API を使うため
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Vue の SPA。/api/* だけ Worker が先に受け取る。
    // /media/*（トップの動画）も Worker を通す: 静的ファイルは Range（一部だけの取得）に 206 で答えず、
    // iPhone・iPad の Safari は 206 が返らない動画を流さないため（worker/media.ts）
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"],
  },
  "vars": {
    "CLAUDE_MODEL": "claude-opus-5-5",
    // ElevenLabs の文字起こしのモデル
    "SCRIBE_MODEL": "scribe_v2",
    // 相手役の声（ElevenLabs のボイスライブラリの日本語の声「Aaa - Native Japanese Conversation」。仮）。空ならブラウザの読み上げを使う
    "TTS_VOICE_ID": "Xe358ecHiAMPqKeziEUB",
    "TTS_MODEL": "eleven_v3",
  },
  // キー（ANTHROPIC_API_KEY・ELEVENLABS_API_KEY）は `wrangler secret put` で入れる。ローカルは .dev.vars
  // QR で開くカンペの置き場（推測できない ID、30日で消える）
  "kv_namespaces": [{ "binding": "KANPE", "id": "3aa8d95c4c164b7a9597dfa87abef2fe" }],
  "observability": { "enabled": true },
}
